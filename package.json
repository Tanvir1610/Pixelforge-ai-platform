{
  "name": "pixelforge-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:verify": "bash scripts/verify-db.sh",
    "db:check": "node scripts/verify-migrations.mjs",
    "check:supabase": "node scripts/check-supabase.mjs",
    "db:push": "supabase db push",
    "db:types": "node -e \"console.error('lib/db/database.types.ts is hand-written; generating over it drops 54 named exports that 20 files import. Edit it by hand, then run npm run typecheck.'); process.exit(1)\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "clsx": "2.1.1",
    "lucide-react": "0.469.0",
    "next": "^16.3.4",
    "pngjs": "^7.0.0",
    "qrcode": "1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "22.10.7",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "^2.1.9"
  }
}
