# =============================================================================
# Template. Committed to a PUBLIC repository — never put a real value in here.
#
# Real values go in `.env.local` (gitignored) for local work, and in the host's
# environment settings for a deployment. Next.js does not read this file.
#
# This file has held live credentials before, including a service-role key, and
# they reached the public git history. If you paste a value here by mistake,
# rotate it rather than just deleting the line: the commit keeps it.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — without all three of these, sign-up fails and the app serves demo
# data. On Vercel: Settings → Environment Variables, for Production, Preview and
# Development, then redeploy. Adding a variable does not rebuild on its own.
# -----------------------------------------------------------------------------

# Supabase → Settings → API → Project URL.
# Exactly this shape: scheme + host, nothing after the .co, no trailing slash.
#   correct    https://abcdefghijklmnopqrst.supabase.co
#   wrong      https://supabase.com/dashboard/project/abcdefghijklmnopqrst
#   wrong      https://abcdefghijklmnopqrst.supabase.co/
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Settings → API → Project API keys → `anon` `public`.
# The NEXT_PUBLIC_ prefix is not optional: without it the browser cannot see the
# value, and setting `SUPABASE_ANON_KEY` instead is the single commonest reason
# this app reports that it is not connected to Supabase.
# Safe to expose — it is the key the browser is meant to use, and RLS is what
# actually protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Settings → API → Project API keys → `service_role`.
# Bypasses RLS completely: full read and write on every table, no policy
# applies. Server-only. Never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# STRONGLY RECOMMENDED in a deployment
# -----------------------------------------------------------------------------

# This app's own public origin, no trailing slash, e.g.
# https://your-app.vercel.app
# Authoritative for OAuth redirect URIs, the host-connect callback and the links
# in confirmation emails. Without it those are built from the request's Host
# header, which a proxy passes through unchanged — so anyone who can set that
# header chooses where your callback returns to.
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# OPTIONAL — each unlocks one pipeline. The app runs without all of them.
# -----------------------------------------------------------------------------

# Model providers. Unset until a provider is registered; the Design Analyst and
# the planners stay disabled and say so on screen.
ANTHROPIC_API_KEY=
# Only for an organization-scoped API key. Such a key must name a workspace on
# every request, and the API rejects it outright without this — "This API key is
# not scoped to a workspace". A workspace-scoped key needs nothing here.
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=

# Figma ingestion. OAuth is the production path; a personal access token is a
# local-development fallback and is used only when no connection row exists.
#
# The OAuth app must be PUBLISHED at figma.com/developers/apps, not merely
# created. Figma changed its developer-platform requirements, and an app left
# unpublished still authenticates at the token endpoint while the authorize page
# refuses it with "OAuth app with client id ... doesn't exist" — which reads
# exactly like a wrong client id and is not. Private publication covers your own
# organization and needs no Figma review.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_PERSONAL_ACCESS_TOKEN=
# Only the scopes your Figma app actually has enabled. Requesting one it does
# not have is refused as {"status":400,"message":"Invalid scopes for app"} on
# Figma's own page, before the user reaches a consent screen and before this
# app sees anything.
#
# Defaults to "file_content:read current_user:read", which is what this app's
# calls need. Note that file_read is deprecated for OAuth 2 tokens and
# files:read is deprecated as well — neither is a safe thing to ask for.
# Space-separated. Read at request time, so a correction needs no redeploy.
FIGMA_OAUTH_SCOPE=

# GitHub, for pushing generated code to a repository.
#
# Register an OAuth App at github.com/settings/developers. Its "Authorization
# callback URL" must be exactly:
#   {NEXT_PUBLIC_APP_URL}/api/connect/github/callback
#
# A GitHub OAuth App allows ONE callback URL. If the app you already have is
# registered against Supabase's sign-in callback, that same app cannot also
# serve this — register a second app, or skip OAuth entirely: a user can paste
# a fine-grained personal access token instead, which needs no app at all.
#
# /api/health reports the exact redirectUri this deployment will send, which is
# the string to register. Both values are read at runtime.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Space-separated. Defaults to "repo read:user" — `repo` is what allows
# creating a repository and pushing to a private one. Use "public_repo
# read:user" to restrict the connection to public repositories only.
GITHUB_OAUTH_SCOPE=

# Host OAuth, for deploying generated projects. Callback for each is
# {NEXT_PUBLIC_APP_URL}/api/connect/{provider}/callback
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# UPI, collected by hand
#
# UPI through a plain VPA has no callback, so nothing tells the app a payment
# arrived. A submitted reference is a claim, never an entitlement: the plan is
# granted only by verify_upi_payment, run by a platform operator below.
#
# Keep the VPA here, not in code. This file is committed to a public repository,
# and a UPI id plus the account holder's legal name is exactly the pair that
# should not be in one.
UPI_PAYEE_VPA=
UPI_PAYEE_NAME=

# Comma-separated emails allowed to confirm a UPI payment. Deliberately not
# workspace admins: the person who paid must not be the person who confirms the
# money arrived.
PLATFORM_ADMIN_EMAILS=

# Payments (Razorpay). Server-only — the secret must never reach the browser.
# Only NEXT_PUBLIC_RAZORPAY_KEY_ID is safe to expose; it is the public key id.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when creating the webhook in the Razorpay dashboard. Distinct from the
# key secret: it signs webhook bodies, and rotating one must not break the other.
RAZORPAY_WEBHOOK_SECRET=
