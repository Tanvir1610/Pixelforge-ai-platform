# =============================================================================
# Template. Committed to a PUBLIC repository — never put a real value in here.
#
# Real values go in `.env.local` (gitignored) for local work, and in the host's
# environment settings for a deployment. Next.js does not read this file.
#
# This file has held live credentials before, including a service-role key, and
# they reached the public git history. If you paste a value here by mistake,
# rotate it rather than just deleting the line: the commit keeps it.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — without all three of these, sign-up fails and the app serves demo
# data. On Vercel: Settings → Environment Variables, for Production, Preview and
# Development, then redeploy. Adding a variable does not rebuild on its own.
# -----------------------------------------------------------------------------

# Supabase → Settings → API → Project URL.
# Exactly this shape: scheme + host, nothing after the .co, no trailing slash.
#   correct    https://abcdefghijklmnopqrst.supabase.co
#   wrong      https://supabase.com/dashboard/project/abcdefghijklmnopqrst
#   wrong      https://abcdefghijklmnopqrst.supabase.co/
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Settings → API → Project API keys → `anon` `public`.
# The NEXT_PUBLIC_ prefix is not optional: without it the browser cannot see the
# value, and setting `SUPABASE_ANON_KEY` instead is the single commonest reason
# this app reports that it is not connected to Supabase.
# Safe to expose — it is the key the browser is meant to use, and RLS is what
# actually protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Settings → API → Project API keys → `service_role`.
# Bypasses RLS completely: full read and write on every table, no policy
# applies. Server-only. Never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# STRONGLY RECOMMENDED in a deployment
# -----------------------------------------------------------------------------

# This app's own public origin, no trailing slash, e.g.
# https://your-app.vercel.app
# Authoritative for OAuth redirect URIs, the host-connect callback and the links
# in confirmation emails. Without it those are built from the request's Host
# header, which a proxy passes through unchanged — so anyone who can set that
# header chooses where your callback returns to.
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# OPTIONAL — each unlocks one pipeline. The app runs without all of them.
# -----------------------------------------------------------------------------

# Model providers. Unset until a provider is registered; the Design Analyst and
# the planners stay disabled and say so on screen.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Figma ingestion. OAuth is the production path; a personal access token is a
# local-development fallback and is used only when no connection row exists.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_PERSONAL_ACCESS_TOKEN=

# Host OAuth, for deploying generated projects. Callback for each is
# {NEXT_PUBLIC_APP_URL}/api/connect/{provider}/callback
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=

# Payments (Razorpay). Server-only — the secret must never reach the browser.
# Only NEXT_PUBLIC_RAZORPAY_KEY_ID is safe to expose; it is the public key id.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when creating the webhook in the Razorpay dashboard. Distinct from the
# key secret: it signs webhook bodies, and rotating one must not break the other.
RAZORPAY_WEBHOOK_SECRET=
